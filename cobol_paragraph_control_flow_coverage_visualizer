            }
        }

        // Core Parsing Routine: Converts raw code into Paragraph structures & branches
        function parseCOBOLCode(code, stripSeq, stripComments) {
            const lines = code.split('\n');
            let processedLines = [];

            for (let line of lines) {
                let processed = line;

                // Strip fixed standard COBOL sequence numbers (Columns 1-6)
                if (stripSeq && processed.length >= 6) {
                    processed = processed.substring(6);
                }

                // Strip fixed standard COBOL Comments (Asterisk in Col 7)
                if (stripComments) {
                    let commentChar = stripSeq ? line.charAt(6) : line.charAt(0);
                    if (commentChar === '*' || commentChar === '/') {
                        continue;
                    }
                }

                // Strip trailing sequence area (past col 72)
                if (stripSeq && processed.length > 66) {
                    processed = processed.substring(0, 66);
                }

                // Clean inline comments using double dash or asterisks
                let inlineCommentIdx = processed.indexOf('*>');
                if (inlineCommentIdx !== -1) {
                    processed = processed.substring(0, inlineCommentIdx);
                }

                processedLines.push(processed);
            }

            let paragraphs = [];
            let currentParagraph = null;

            // Regex for paragraphs and sections
            // Match any line that has an identifier followed by a dot, with no other code on that line
            const paragraphRegex = /^\s*([A-Za-z0-9_-]+)\s*\.\s*$/i;
            const sectionRegex = /^\s*([A-Za-z0-9_-]+)\s+SECTION\s*\.\s*$/i;

            for (let i = 0; i < processedLines.length; i++) {
                let lineText = processedLines[i].trim();
                if (!lineText) continue;

                let matchPara = lineText.match(paragraphRegex);
                let matchSec = lineText.match(sectionRegex);
                let paraName = null;

                if (matchSec) paraName = matchSec[1];
                else if (matchPara) paraName = matchPara[1];

                // Exclude system/common COBOL control command flow words ending in dot
                const systemIgnore = ["EXIT", "STOP", "RUN", "GOBACK"];
                if (paraName && systemIgnore.includes(paraName.toUpperCase())) {
                    paraName = null;
                }

                if (paraName) {
                    if (currentParagraph) {
                        paragraphs.push(currentParagraph);
                    }
                    currentParagraph = {
                        name: paraName,
                        lines: [],
                        controls: []
                    };
                } else {
                    if (currentParagraph) {
                        currentParagraph.lines.push(processedLines[i]);
                    }
                }
            }

            if (currentParagraph) {
                paragraphs.push(currentParagraph);
            }

            // Tokenizer regex matching branching elements sequentially to support nesting scopes
            const tokenRegex = /(IF\b)|(ELSE\b)|(END-IF\b)|(EVALUATE\b)|(WHEN\b[^.\n]*)|(END-EVALUATE\b)|(PERFORM\b\s+[A-Za-z0-9_-]+(?:(?:\s+UNTIL|\s+VARYING)[^.\n]*)?)|(\.)/gi;

            // Extract control branch flows within each paragraph using Stack-based tree parsing
            paragraphs.forEach(para => {
                let paragraphText = para.lines.join('\n');
                let controlCounter = 0;
                
                let controlsTree = [];
                let stack = [ { targetList: controlsTree, type: 'ROOT' } ];

                let match;
                while ((match = tokenRegex.exec(paragraphText)) !== null) {
                    let token = match[0];
                    let upperToken = token.toUpperCase();

                    if (upperToken.startsWith('IF')) {
                        let c = {
                            id: `${para.name}-ctrl-${controlCounter++}`,
                            type: 'IF_ELSE',
                            text: 'IF Decision',
                            branches: [
                                { name: 'IF True', controls: [] },
                                { name: 'ELSE', controls: [] }
                            ],
                            tested: [false, false]
                        };
                        stack[stack.length-1].targetList.push(c);
                        stack.push({ targetList: c.branches[0].controls, type: 'IF', ref: c });
                    } 
                    else if (upperToken.startsWith('ELSE')) {
                        let idx = stack.length - 1;
                        while(idx >= 0 && stack[idx].type !== 'IF') idx--;
                        if (idx >= 0) {
                            stack.length = idx + 1; // pop nested blocks inside IF True
                            stack[stack.length-1].targetList = stack[stack.length-1].ref.branches[1].controls;
                        }
                    } 
                    else if (upperToken.startsWith('END-IF')) {
                        let idx = stack.length - 1;
                        while(idx >= 0 && stack[idx].type !== 'IF') idx--;
                        if (idx >= 0) stack.length = idx; // Close IF block
                    } 
                    else if (upperToken.startsWith('EVALUATE')) {
                        let c = {
                            id: `${para.name}-ctrl-${controlCounter++}`,
                            type: 'EVALUATE',
                            text: 'EVALUATE Block',
                            branches: [],
                            tested: []
                        };
                        stack[stack.length-1].targetList.push(c);
                        stack.push({ targetList: [], type: 'EVALUATE', ref: c });
                    } 
                    else if (upperToken.startsWith('WHEN')) {
                        let idx = stack.length - 1;
                        while(idx >= 0 && stack[idx].type !== 'EVALUATE') idx--;
                        if (idx >= 0) {
                            stack.length = idx + 1;
                            let ref = stack[stack.length-1].ref;
                            let bIdx = ref.branches.length;
                            ref.branches.push({ name: token.trim(), controls: [] });
                            ref.tested.push(false);
                            stack[stack.length-1].targetList = ref.branches[bIdx].controls;
                        }
                    } 
                    else if (upperToken.startsWith('END-EVALUATE')) {
                        let idx = stack.length - 1;
                        while(idx >= 0 && stack[idx].type !== 'EVALUATE') idx--;
                        if (idx >= 0) stack.length = idx;
                    } 
                    else if (upperToken.startsWith('PERFORM')) {
                        let targetMatch = token.match(/PERFORM\s+([A-Za-z0-9_-]+)/i);
                        if (targetMatch) {
                            let isLoop = upperToken.includes('UNTIL') || upperToken.includes('VARYING');
                            let c = {
                                id: `${para.name}-ctrl-${controlCounter++}`,
                                type: isLoop ? 'PERFORM_LOOP' : 'PERFORM',
                                target: targetMatch[1],
                                text: token.trim(),
                                tested: false
                            };
                            stack[stack.length-1].targetList.push(c);
                        }
                    } 
                    else if (token === '.') {
                        // Sentence terminator closes all conditionally open scopes in standard COBOL back to root
                        stack = [stack[0]];
                    }
                }
                
                para.controls = controlsTree;
            });

            return paragraphs;
        }

        // Action when pressing "Parse & Re-Generate Graph"
        function processSourceCode() {
            const code = document.getElementById('cobol-code').value;
            const stripSeq = document.getElementById('chk-strip-seq').checked;
            const stripComments = document.getElementById('chk-strip-comments').checked;

            if (!code.trim()) {
                showNotification("No Code Found", "Please paste or load a demo COBOL program.", "warn");
                return;
            }

            appState.rawCode = code;
            appState.stripSequence = stripSeq;
            appState.stripComments = stripComments;

            // Generate parsed syntax items
            const parsedParas = parseCOBOLCode(code, stripSeq, stripComments);
            if (parsedParas.length === 0) {
                showNotification("Parsing Issue", "No paragraph divisions or SECTION declarations found.", "warn");
                return;
            }

            // Sync with existing coverage states to prevent losing edits when changing minor structure
            parsedParas.forEach(p => {
                // Initialize default paragraph manual mapping
                if (!appState.resolutions[p.name]) {
                    appState.resolutions[p.name] = {};
                }

                forEachControl(p.controls, c => {
                    // Restore branch coverage recursively
                    if (c.type === 'IF_ELSE' || c.type === 'EVALUATE') {
                        c.tested.forEach((val, idx) => {
                            const key = `${c.id}_branch_${idx}`;
                            if (appState.coverage[key] !== undefined) {
                                c.tested[idx] = appState.coverage[key];
                            } else {
                                appState.coverage[key] = false;
                            }
                        });
                    } else {
                        // Direct performers
                        if (appState.coverage[c.id] !== undefined) {
                            c.tested = appState.coverage[c.id];
                        } else {
                            appState.coverage[c.id] = false;
                        }
                    }
                });
            });

            appState.paragraphs = parsedParas;

            // Initialize default coordinates for paragraphs if empty
            appState.paragraphs.forEach((p, idx) => {
                if (!appState.nodePositions[p.name]) {
                    // Spread cleanly inside canvas grid dynamically initially
                    appState.nodePositions[p.name] = {
                        x: 50 + (idx % 3) * 380,
                        y: 80 + Math.floor(idx / 3) * 320
                    };
                }
            });

            saveToLocalStorage();
            updateUIFromState();
            showNotification("Parse Successful", `Parsed ${parsedParas.length} paragraphs successfully! View them on Step 2.`);
            switchTab('visualizer-tab');
        }

        // Applies a logical DAG layout based on control PERFORM directions (Left to Right)
        function applyAutoLayout() {
            if (appState.paragraphs.length === 0) return;

            let deps = {};
            let inDegree = {};

            appState.paragraphs.forEach(p => {
                deps[p.name] = [];
                inDegree[p.name] = 0;
            });

            // Connect dependencies
            appState.paragraphs.forEach(p => {
                forEachControl(p.controls, c => {
                    if (c.target && deps[p.name]) {
                        // Ensure we target a valid paragraph node
                        let targetExists = appState.paragraphs.some(tp => tp.name === c.target);
                        if (targetExists && !deps[p.name].includes(c.target)) {
                            deps[p.name].push(c.target);
                        }
                    }
                });
            });

            // Calculate degrees
            Object.keys(deps).forEach(src => {
                deps[src].forEach(dest => {
                    if (inDegree[dest] !== undefined) {
                        inDegree[dest]++;
                    }
                });
            });

            // Assign structural grid levels (Columns)
            let levels = {};
            let queue = [];

            // Seed levels with root elements (0 in-degree)
            Object.keys(inDegree).forEach(name => {
                if (inDegree[name] === 0) {
                    levels[name] = 0;
                    queue.push(name);
                }
            });

            // Fail-safe seed if there is cyclic flow
            if (queue.length === 0 && appState.paragraphs.length > 0) {
                let first = appState.paragraphs[0].name;
                levels[first] = 0;
                queue.push(first);
            }

            while (queue.length > 0) {
                let curr = queue.shift();
                let currLvl = levels[curr] || 0;

                if (deps[curr]) {
                    deps[curr].forEach(dest => {
                        if (levels[dest] === undefined || levels[dest] < currLvl + 1) {
                            levels[dest] = currLvl + 1;
                            queue.push(dest);
                        }
                    });
                }
            }

            // Assign defaults to unlinked paragraphs
            appState.paragraphs.forEach(p => {
                if (levels[p.name] === undefined) {
                    levels[p.name] = 0;
                }
            });

            // Build structural dynamic layout columns
            let columns = {};
            appState.paragraphs.forEach(p => {
                let lvl = levels[p.name];
                if (!columns[lvl]) columns[lvl] = [];
                columns[lvl].push(p.name);
            });

            // Apply 2D absolute positions to graph nodes
            const widthPerCol = 420;
            const heightPerRow = 340;
            const originX = 60;
            const originY = 80;

            Object.keys(columns).forEach(colIdx => {
                let level = parseInt(colIdx);
                let list = columns[level];
                list.forEach((name, rowIdx) => {
                    appState.nodePositions[name] = {
                        x: originX + level * widthPerCol,
                        y: originY + rowIdx * heightPerRow
                    };
                });
            });

            saveToLocalStorage();
            renderVisualizerWorkspace();
            showNotification("Layout Complete", "Arranged paragraph flow automatically.");
        }

        // Translates paragraph name into user mappings based on active manual picks
        function resolveParagraphName(paraName) {
            const tokens = paraName.split('-');
            const resolvedTokens = tokens.map(token => {
                const upperToken = token.toUpperCase();
                
                // Check if user has explicitly chosen a manual resolution option for this token
                if (appState.resolutions[paraName] && appState.resolutions[paraName][upperToken]) {
                    return appState.resolutions[paraName][upperToken];
                }

                // If not manually mapped yet but exists in global dictionary, auto-assign first mapping option
                if (appState.dictionary[upperToken] && appState.dictionary[upperToken].length > 0) {
                    return appState.dictionary[upperToken][0];
                }

                // Fallback to original token string
                return token;
            });

            return resolvedTokens.join('-');
        }

