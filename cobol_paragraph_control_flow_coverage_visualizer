<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>COB-Viz: COBOL Flow & Coverage Visualizer</title>
    <!-- Tailwind CSS for modern utility styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Inter & Fira Code Fonts from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Custom Style Block for specialized styles -->
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #0f172a;
            color: #f1f5f9;
        }
        
        .code-font {
            font-family: 'Fira Code', monospace;
        }

        /* Custom Scrollbars for slick look */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #1e293b;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }

        /* Dot matrix grid styling for interactive visualizer canvas */
        .grid-bg {
            background-image: radial-gradient(#334155 1.5px, transparent 1.5px);
            background-size: 24px 24px;
            background-color: #0b0f19;
            cursor: grab;
        }
        .grid-bg:active {
            cursor: grabbing;
        }

        /* Smooth path transition styling */
        .flow-path {
            transition: stroke 0.2s, stroke-width 0.2s;
        }
        .flow-path:hover {
            stroke-width: 5px !important;
            filter: drop-shadow(0px 0px 8px currentColor);
        }

        /* Card styles while dragging */
        .dragging {
            opacity: 0.75;
            cursor: grabbing !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 25px 50px -12px rgba(56, 189, 248, 0.25) !important;
        }

        /* Prevent text selection during drag-and-drop */
        .no-select {
            user-select: none;
            -webkit-user-select: none;
        }
    </style>
</head>
<body class="h-screen flex flex-col overflow-hidden">

    <!-- Application Top Bar Header -->
    <header class="bg-slate-900 border-b border-slate-800 px-6 py-4 flex items-center justify-between shrink-0">
        <div class="flex items-center space-x-3">
            <!-- Logo Icon (SVG) -->
            <svg class="w-8 h-8 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
            <div>
                <h1 class="text-xl font-bold tracking-tight text-white flex items-center gap-2">
                    COB-Viz <span class="text-xs bg-cyan-500/20 text-cyan-400 font-normal px-2.5 py-0.5 rounded-full border border-cyan-500/30">Enterprise v2.0</span>
                </h1>
                <p class="text-xs text-slate-400">Interactive COBOL Control Flow, Manual Coverage & Abbreviation Dictionary Mapper</p>
            </div>
        </div>

        <!-- Global Navigation / Tabs & State Controls -->
        <div class="flex items-center space-x-6">
            <!-- Tabs Menu -->
            <div class="bg-slate-950 p-1 rounded-lg border border-slate-800 flex space-x-1">
                <button onclick="switchTab('input-tab')" id="btn-input-tab" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-150 bg-slate-800 text-white shadow-inner">
                    1. Input & Dictionary
                </button>
                <button onclick="switchTab('visualizer-tab')" id="btn-visualizer-tab" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-150 text-slate-400 hover:text-white">
                    2. Flow Graph Visualizer
                </button>
                <button onclick="switchTab('report-tab')" id="btn-report-tab" class="px-4 py-2 text-sm font-medium rounded-md transition-all duration-150 text-slate-400 hover:text-white">
                    3. Export Report
                </button>
            </div>

            <!-- Import/Export & Reset Controls -->
            <div class="flex items-center space-x-2 border-l border-slate-800 pl-4">
                <button onclick="saveProject()" class="bg-slate-800 hover:bg-slate-700 text-white text-xs px-3 py-2 rounded border border-slate-700 font-medium flex items-center gap-1" title="Save Workspace to Browser">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"></path></svg>
                    Save Status
                </button>
                <button onclick="exportAsJSON()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-xs px-3 py-2 rounded font-medium flex items-center gap-1" title="Export Project to JSON File">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Export File
                </button>
                <button onclick="triggerImport()" class="bg-slate-800 hover:bg-slate-700 text-white text-xs px-3 py-2 rounded border border-slate-700 font-medium flex items-center gap-1" title="Load Project from JSON File">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0l-4 4m4-4v12"></path></svg>
                    Import File
                </button>
                <input type="file" id="file-import" class="hidden" accept=".json" onchange="importFromJsonFile(event)">
            </div>
        </div>
    </header>

    <!-- Main Content Container with Dynamic Views -->
    <main class="flex-1 overflow-hidden relative">

        <!-- TAB 1: INPUT AND DICTIONARY SETUP -->
        <div id="view-input-tab" class="absolute inset-0 p-6 overflow-y-auto flex flex-col md:flex-row gap-6">
            <!-- Left Panel: COBOL Code Parser Panel -->
            <div class="flex-1 flex flex-col bg-slate-900 border border-slate-800 rounded-xl p-5 overflow-hidden min-h-[500px]">
                <div class="flex items-center justify-between mb-3 shrink-0">
                    <div>
                        <h2 class="text-md font-semibold text-white">COBOL Program Source</h2>
                        <p class="text-xs text-slate-400">Paste your COBOL paragraph flow here</p>
                    </div>
                    <div class="flex items-center space-x-2">
                        <button onclick="loadSampleProgram()" class="text-xs bg-slate-800 text-cyan-400 border border-slate-700 hover:bg-slate-700 px-3 py-1.5 rounded transition duration-150">
                            Load Demo Code
                        </button>
                    </div>
                </div>

                <!-- Parsing Option Filters -->
                <div class="flex flex-wrap gap-4 items-center mb-3 bg-slate-950 p-3 rounded-lg border border-slate-800">
                    <label class="flex items-center space-x-2 text-xs text-slate-300 select-none cursor-pointer">
                        <input type="checkbox" id="chk-strip-seq" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-cyan-500">
                        <span>Strip Line Sequence Cols 1-6</span>
                    </label>
                    <label class="flex items-center space-x-2 text-xs text-slate-300 select-none cursor-pointer">
                        <input type="checkbox" id="chk-strip-comments" checked class="rounded border-slate-700 bg-slate-800 text-cyan-500 focus:ring-cyan-500">
                        <span>Strip Fixed Comments (Col 7 / *)</span>
                    </label>
                </div>

                <!-- Code input Area -->
                <textarea id="cobol-code" class="flex-1 w-full bg-slate-950 text-emerald-400 border border-slate-800 rounded-lg p-4 code-font text-xs resize-none focus:outline-none focus:ring-1 focus:ring-cyan-500 mb-4 overflow-y-auto" placeholder="PROCEDURE DIVISION.&#10;A000-MAIN-PCS.&#10;    PERFORM A010-STT-SLT-ORD-INF.&#10;    GOBACK."></textarea>

                <button onclick="processSourceCode()" class="w-full bg-cyan-600 hover:bg-cyan-500 text-white font-semibold py-3 rounded-lg transition-all duration-150 shadow-lg shrink-0 flex justify-center items-center gap-2 text-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.7 15.3a6 6 0 111.4-1.4l4.9 4.9-1.4 1.4-4.9-4.9zM10 14a4 4 0 100-8 4 4 0 000 8z"></path></svg>
                    Parse Code & Re-Generate Flow Graph
                </button>
            </div>

            <!-- Right Panel: Dictionary Manager Panel -->
            <div class="w-full md:w-96 bg-slate-900 border border-slate-800 rounded-xl p-5 flex flex-col shrink-0 overflow-hidden">
                <div class="mb-3 shrink-0">
                    <h2 class="text-md font-semibold text-white">Abbreviation Dictionary</h2>
                    <p class="text-xs text-slate-400">Map paragraph codes to user friendly terms (Comma-separated values)</p>
                </div>

                <!-- Custom Dictionary Adder Form -->
                <div class="space-y-2 mb-4 p-3 bg-slate-950 rounded-lg border border-slate-800 shrink-0">
                    <div class="flex items-center justify-between mb-2 pb-2 border-b border-slate-800">
                        <span class="text-xs text-slate-400 font-medium">Add mapping manually or bulk import:</span>
                        <button onclick="document.getElementById('dict-file-import').click()" class="bg-indigo-600 hover:bg-indigo-500 text-white text-[10px] px-2 py-1 rounded flex items-center gap-1 transition">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0l-4 4m4-4v12"></path></svg> Bulk Import TXT
                        </button>
                        <input type="file" id="dict-file-import" class="hidden" accept=".txt" onchange="importDictionaryFile(event)">
                    </div>
                    <div class="grid grid-cols-3 gap-2">
                        <input type="text" id="dict-key" class="bg-slate-900 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-white uppercase focus:outline-none focus:ring-1 focus:ring-cyan-500 col-span-1" placeholder="PCS">
                        <input type="text" id="dict-value" class="bg-slate-900 border border-slate-800 rounded px-2.5 py-1.5 text-xs text-white focus:outline-none focus:ring-1 focus:ring-cyan-500 col-span-2" placeholder="PROCESS, PROCESSING">
                    </div>
                    <button onclick="addDictionaryEntry()" class="w-full bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white py-1.5 text-xs rounded transition duration-150 font-medium">
                        + Add Mapping Word
                    </button>
                </div>

                <!-- Current Dictionary List Container -->
                <div class="flex-1 overflow-y-auto pr-1">
                    <table class="w-full text-left text-xs">
                        <thead>
                            <tr class="text-slate-400 border-b border-slate-800">
                                <th class="pb-2 font-medium">Abbr.</th>
                                <th class="pb-2 font-medium">Possible Expanded Values</th>
                                <th class="pb-2 font-medium text-right">Action</th>
                            </tr>
                        </thead>
                        <tbody id="dictionary-list-tbody" class="divide-y divide-slate-800">
                            <!-- Populated Dynamically by script -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 2: INTERACTIVE VISUALIZER WORKSPACE -->
        <div id="view-visualizer-tab" class="hidden absolute inset-0 flex overflow-hidden">
            <!-- Left Sidebar Controls -->
            <div class="w-64 bg-slate-900 border-r border-slate-800 flex flex-col shrink-0 overflow-y-auto p-4 space-y-4">
                <div>
                    <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Workspace Controls</h3>
                    
                    <!-- Toggle Abbreviated vs Full Name Mode -->
                    <div class="space-y-3 bg-slate-950 p-3 rounded-lg border border-slate-800">
                        <div>
                            <span class="text-xs text-slate-400 block mb-2">Paragraph Title Display:</span>
                            <div class="flex bg-slate-900 p-1 rounded-md border border-slate-800">
                                <button onclick="setResolvedMode(false)" id="btn-abbr-view" class="flex-1 text-center py-1.5 text-xs font-medium rounded transition duration-150 bg-cyan-600 text-white">
                                    Abbreviated
                                </button>
                                <button onclick="setResolvedMode(true)" id="btn-resolved-view" class="flex-1 text-center py-1.5 text-xs font-medium rounded transition duration-150 text-slate-400 hover:text-white">
                                    Resolved
                                </button>
                            </div>
                        </div>

                        <!-- Auto Layout Trigger -->
                        <button onclick="applyAutoLayout()" class="w-full bg-slate-800 hover:bg-slate-700 border border-slate-700 text-white text-xs font-medium py-2 rounded flex items-center justify-center gap-1.5 transition duration-150">
                            <svg class="w-3.5 h-3.5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                            Auto Layout Nodes
                        </button>
                    </div>
                </div>

                <!-- Zooming Tools Panel -->
                <div>
                    <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Visual Scale</h3>
                    <div class="flex items-center space-x-1.5 bg-slate-950 p-2.5 rounded-lg border border-slate-800">
                        <button onclick="changeZoom(-0.1)" class="w-8 h-8 flex items-center justify-center bg-slate-900 border border-slate-800 rounded hover:bg-slate-800 font-bold text-slate-300">-</button>
                        <span id="zoom-value" class="flex-1 text-center font-mono text-xs text-white">100%</span>
                        <button onclick="changeZoom(0.1)" class="w-8 h-8 flex items-center justify-center bg-slate-900 border border-slate-800 rounded hover:bg-slate-800 font-bold text-slate-300">+</button>
                        <button onclick="resetZoom()" class="px-2 py-1 bg-slate-900 border border-slate-800 rounded hover:bg-slate-800 text-xs text-slate-400">Reset</button>
                    </div>
                </div>

                <!-- Interactive Legend -->
                <div class="mt-auto pt-2">
                    <h3 class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Visual Flow Legend</h3>
                    <div class="bg-slate-950 p-3 rounded-lg border border-slate-800 space-y-2.5 text-xs text-slate-300">
                        <div class="flex items-center space-x-2">
                            <span class="inline-block w-4 h-1 bg-emerald-500 rounded"></span>
                            <span>Tested Branch / Call</span>
                        </div>
                        <div class="flex items-center space-x-2">
                            <span class="inline-block w-4 h-1 bg-rose-500 rounded"></span>
                            <span>Untested Branch / Call</span>
                        </div>
                        <div class="text-[11px] text-slate-400 pt-1 leading-relaxed border-t border-slate-850">
                            <strong>Interactive:</strong> Click lines/branches to toggle status. Drag paragraph headers to organize. <br>
                            <strong>Line routing:</strong> Click & drag empty space to pan. Drag line paths to route around cards. Right-click path nodes to delete routing handles.
                        </div>
                    </div>
                </div>

                <!-- Live Coverage Panel -->
                <div class="bg-slate-950 border border-slate-800 p-3 rounded-lg">
                    <div class="text-xs text-slate-400 mb-1">Global Testing Progress:</div>
                    <div class="flex items-center justify-between font-mono text-xs text-white font-bold mb-1.5">
                        <span id="tested-count">0/0</span>
                        <span id="tested-percentage">0%</span>
                    </div>
                    <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                        <div id="tested-progress-bar" class="bg-cyan-500 h-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <!-- Visual Graph Workspace Container -->
            <div class="flex-1 overflow-auto bg-slate-950 grid-bg relative" id="canvas-container">
                <!-- Outer Workspace Container -->
                <div id="visual-workspace" class="relative w-[4000px] h-[3000px] origin-top-left transition-transform duration-75">
                    
                    <!-- SVG Overlay layer for connection lines -->
                    <svg id="svg-overlay" class="absolute inset-0 pointer-events-none w-full h-full">
                        <!-- Markers definition for flow arrows -->
                        <defs>
                            <marker id="arrow-untested" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" fill="#ef4444" />
                            </marker>
                            <marker id="arrow-tested" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                                <path d="M 0 0 L 10 5 L 0 10 z" fill="#10b981" />
                            </marker>
                        </defs>
                        <!-- Dynamic SVG paths drawn in render() -->
                        <g id="svg-connections-group"></g>
                    </svg>

                    <!-- Absolutely positioned paragraph cards container -->
                    <div id="nodes-container" class="absolute inset-0"></div>

                </div>
            </div>
        </div>

        <!-- TAB 3: SUMMARY COVERAGE REPORT -->
        <div id="view-report-tab" class="hidden absolute inset-0 p-6 overflow-y-auto">
            <div class="max-w-5xl mx-auto bg-slate-900 border border-slate-800 rounded-xl p-6 shadow-2xl space-y-6">
                <!-- Header of Report -->
                <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-slate-800">
                    <div>
                        <h2 class="text-xl font-bold text-white">COBOL Program Coverage Summary</h2>
                        <p class="text-xs text-slate-400">Consolidated list of paragraph testing status, abbreviations and developer comments.</p>
                    </div>
                    <button onclick="window.print()" class="bg-cyan-600 hover:bg-cyan-500 text-white text-xs px-4 py-2 rounded font-medium flex items-center gap-1.5 transition">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path></svg>
                        Print Summary Report
                    </button>
                </div>

                <!-- Stats summary block -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="bg-slate-950 border border-slate-850 p-4 rounded-lg">
                        <div class="text-slate-400 text-xs">Total Paragraphs</div>
                        <div id="report-total-paragraphs" class="text-2xl font-bold font-mono text-white mt-1">0</div>
                    </div>
                    <div class="bg-slate-950 border border-slate-850 p-4 rounded-lg">
                        <div class="text-slate-400 text-xs">Total Branches Checked</div>
                        <div id="report-total-branches" class="text-2xl font-bold font-mono text-white mt-1">0</div>
                    </div>
                    <div class="bg-slate-950 border border-slate-850 p-4 rounded-lg">
                        <div class="text-slate-400 text-xs">Tested Paths</div>
                        <div id="report-tested-branches" class="text-2xl font-bold font-mono text-emerald-400 mt-1">0</div>
                    </div>
                    <div class="bg-slate-950 border border-slate-850 p-4 rounded-lg">
                        <div class="text-slate-400 text-xs">Calculated Coverage</div>
                        <div id="report-percentage" class="text-2xl font-bold font-mono text-cyan-400 mt-1">0%</div>
                    </div>
                </div>

                <!-- Detailed Breakdown Table -->
                <div class="overflow-x-auto border border-slate-800 rounded-lg">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="bg-slate-950 text-slate-300 font-semibold border-b border-slate-800">
                                <th class="p-3">Paragraph Node (Abbr. & Full Mapped Name)</th>
                                <th class="p-3">Tested Branches Coverage</th>
                                <th class="p-3">Paragraph & Flow Notes</th>
                            </tr>
                        </thead>
                        <tbody id="report-tbody" class="divide-y divide-slate-800 text-slate-300">
                            <!-- Dynamic Content -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </main>

    <!-- Global Alert / Custom Toast Overlay (No native alerts allowed) -->
    <div id="custom-toast" class="fixed bottom-5 right-5 z-50 bg-slate-900 border border-slate-800 text-white rounded-lg p-4 shadow-2xl flex items-center gap-3 transform translate-y-20 opacity-0 transition-all duration-350 pointer-events-none">
        <div id="toast-icon-box" class="w-8 h-8 rounded-full flex items-center justify-center bg-cyan-500/20 text-cyan-400">
            <!-- Icon Dynamic -->
        </div>
        <div>
            <div id="toast-title" class="font-bold text-sm">Status Update</div>
            <div id="toast-message" class="text-xs text-slate-400">Action performed.</div>
        </div>
    </div>

    <!-- JS Logic Core -->
    <script>
        // Global Application State Object
        let appState = {
            rawCode: "",
            dictionary: {
                "PCS": ["PROCESS", "PROCESSING", "PIECES"],
                "STT": ["START", "STATE", "STATUS"],
                "SLT": ["SELECT", "SLOT", "SOLUTION"],
                "ORD": ["ORDER", "ORDINARY"],
                "INF": ["INFORMATION", "INFERENCE"],
                "EVAL": ["EVALUATE", "EVALUATION"],
                "RCD": ["RECORD", "RECORDING", "RECODE"],
                "TYP": ["TYPE", "TYPING"],
                "PRF": ["PERFORM", "PREFIX"],
                "UNT": ["UNTIL", "UNIT"],
                "EOF": ["END-OF-FILE", "EOF-MARKER"],
                "ERR": ["ERROR", "ERRANT"]
            },
            resolutions: {},       // Selected resolutions: { "ParagraphName": { "STT": "START" } }
            paragraphs: [],        // Parsed paragraph nodes and control branches
            comments: {},          // Paragraph-level manual user comments
            controlComments: {},   // Individual branch manual user comments
            nodePositions: {},     // 2D placement of nodes: { "ParagraphName": {x: 100, y: 150} }
            coverage: {},          // Coverage states: { "branchId": true/false }
            lineControlPoints: {}, // Manual 2D routing coordinate lists of lines: { "connectionKey": [{x,y}, ...] }
            showResolved: false,   // Current global node-header title mode
            stripSequence: true,   // Clear 1-6 columns
            stripComments: true,   // Remove * lines
            zoomLevel: 1.0         // Scale factor for interactive canvas
        };

        // Workspace Drag & Route Globals
        let isPanning = false;
        let panStartX = 0, panStartY = 0;
        let panStartScrollLeft = 0, panStartScrollTop = 0;
        let isDraggingCP = false;
        let activeCPDrag = null;

        // Window Init: Run on start
        window.onload = function() {
            loadFromLocalStorage();
            if (!appState.rawCode) {
                loadSampleProgram();
            } else {
                updateUIFromState();
            }
            
            // Set up Global Canvas listeners for line drawing and window resize
            window.addEventListener('resize', drawFlowlines);
            const container = document.getElementById('canvas-container');
            if (container) {
                container.addEventListener('scroll', drawFlowlines);
                
                // Clicking workspace empty background triggers panning mechanics
                container.addEventListener('mousedown', function(e) {
                    if (e.button !== 0) return; // Left clicks only
                    
                    const isBg = e.target.id === 'canvas-container' || 
                                 e.target.id === 'visual-workspace' || 
                                 e.target.id === 'svg-overlay' ||
                                 e.target.tagName === 'svg';
                                 
                    if (isBg) {
                        isPanning = true;
                        panStartX = e.clientX;
                        panStartY = e.clientY;
                        panStartScrollLeft = container.scrollLeft;
                        panStartScrollTop = container.scrollTop;
                        container.style.cursor = 'grabbing';
                        e.preventDefault(); // Prevent text highlights
                    }
                });
            }

            // Universal mouse handlers for dragging handles and workspace pan offsets
            window.addEventListener('mousemove', function(e) {
                if (isPanning && container) {
                    const dx = e.clientX - panStartX;
                    const dy = e.clientY - panStartY;
                    container.scrollLeft = panStartScrollLeft - dx;
                    container.scrollTop = panStartScrollTop - dy;
                }
                
                if (isDraggingCP && activeCPDrag) {
                    const workspace = document.getElementById('visual-workspace');
                    if (workspace) {
                        const rect = workspace.getBoundingClientRect();
                        const mouseX = (e.clientX - rect.left) / appState.zoomLevel;
                        const mouseY = (e.clientY - rect.top) / appState.zoomLevel;
                        
                        if (!appState.lineControlPoints[activeCPDrag.connectionKey]) {
                            appState.lineControlPoints[activeCPDrag.connectionKey] = [];
                        }
                        appState.lineControlPoints[activeCPDrag.connectionKey][activeCPDrag.index] = { x: mouseX, y: mouseY };
                        drawFlowlines();
                    }
                }
            });

            window.addEventListener('mouseup', function() {
                if (isPanning && container) {
                    isPanning = false;
                    container.style.cursor = 'grab';
                }
                if (isDraggingCP) {
                    isDraggingCP = false;
                    activeCPDrag = null;
                    saveToLocalStorage();
                }
            });
        };

