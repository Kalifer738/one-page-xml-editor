                                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>Code
                            </button>
                        </div>
                        <div class="flex flex-wrap items-center gap-1.5 leading-none">
                            ${tokensHTML.join('<span class="text-slate-600">-</span>')}
