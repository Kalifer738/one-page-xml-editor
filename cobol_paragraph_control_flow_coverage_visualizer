        // Generates the paragraph card elements and populates visual workspace
        function renderVisualizerWorkspace() {
            const container = document.getElementById('nodes-container');
            if (!container) return;

            container.innerHTML = '';

            appState.paragraphs.forEach(para => {
                const pos = appState.nodePositions[para.name] || { x: 50, y: 50 };
                
                // Build Card Container Box
                const card = document.createElement('div');
                card.id = `card-${para.name}`;
                card.className = "absolute w-80 bg-slate-900 border border-slate-800 rounded-xl shadow-xl flex flex-col overflow-hidden no-select hover:border-slate-700 transition-colors";
                card.style.left = `${pos.x}px`;
                card.style.top = `${pos.y}px`;

                // Card Header Token Resolver Segment
                let headerContent = '';
                if (appState.showResolved) {
                    headerContent = `
                        <div class="flex justify-between items-start mb-1">
                            <div class="text-[10px] text-slate-500 font-mono">Raw: ${para.name}</div>
                            <button onclick="jumpToCode('${para.name}')" class="text-[9px] bg-slate-850 hover:bg-slate-700 text-cyan-400 px-1.5 py-0.5 rounded border border-slate-750 flex items-center gap-1 transition shadow-sm">
                                <svg class="w-2.5 h-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>Code
                            </button>
