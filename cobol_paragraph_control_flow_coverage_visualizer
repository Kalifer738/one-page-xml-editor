                            const currentVal = appState.resolutions[para.name]?.[upperToken] || appState.dictionary[upperToken][0];
                            let optionsHTML = '';
                            
                            appState.dictionary[upperToken].forEach(opt => {
                                optionsHTML += `<option value="${opt}" ${opt === currentVal ? 'selected' : ''}>${opt}</option>`;
