                                    ${isBranchTested ? 'OK' : 'No'}
                                </button>
                             </div>
                             <input type="text" onchange="updateBranchNote('${ctrl.id}', ${bIdx}, this.value)" value="${appState.controlComments[key] || ''}" placeholder="Branch note..." class="w-full bg-slate-950 border border-slate-800 rounded px-1 py-0.5 text-[8px] text-slate-400 focus:outline-none focus:border-slate-700">
                        `;
                        
