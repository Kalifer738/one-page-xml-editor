        // Bulk import words to dictionary from TXT (Format: Word <spaces> Abbr)
        function importDictionaryFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                const text = e.target.result;
                const lines = text.split('\n');
                let added = 0;

                lines.forEach(line => {
                    const cleanLine = line.trim();
                    if (!cleanLine) return;
                    
                    // Regex matching: preceding words then spaces then abbreviation
                    const parts = cleanLine.split(/\s+/);
                    if (parts.length >= 2) {
                        const abbr = parts.pop().toUpperCase();
                        const word = parts.join(' ').toUpperCase();
                        
                        if (!appState.dictionary[abbr]) {
                            appState.dictionary[abbr] = [];
                        }
                        if (!appState.dictionary[abbr].includes(word)) {
                            appState.dictionary[abbr].push(word);
                            added++;
                        }
                    }
                });

                renderDictionary();
                saveToLocalStorage();
                document.getElementById('dict-file-import').value = ''; // Reset input
                showNotification("Bulk Import Success", `Added ${added} new mapping relations.`);
                if (appState.paragraphs.length > 0) renderVisualizerWorkspace();
            };
            reader.readAsText(file);
        }

