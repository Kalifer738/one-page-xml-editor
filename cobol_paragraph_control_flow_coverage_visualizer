                }

                // Append Card Header
                const cardHeader = document.createElement('div');
                cardHeader.className = "card-drag-handle bg-slate-950 px-4 py-3 border-b border-slate-850 cursor-grab flex flex-col justify-between select-none";
                cardHeader.innerHTML = headerContent;
                card.appendChild(cardHeader);

                // Card Control Paths list (Internal elements) built using recursion
                const cardBody = document.createElement('div');
                cardBody.className = "p-2.5 space-y-1.5 flex-1 overflow-y-auto max-h-64";
                
                renderControlsToCard(para.controls, cardBody, false);
                
                card.appendChild(cardBody);

                // Paragraph level comment box footer section
                const cardFooter = document.createElement('div');
                cardFooter.className = "px-3 pb-3 shrink-0";
                cardFooter.innerHTML = `
                    <div class="pt-2 border-t border-slate-850">
                        <textarea onchange="updateParagraphComment('${para.name}', this.value)" class="w-full bg-slate-950 border border-slate-850 rounded-lg p-2 text-[10px] text-slate-300 placeholder-slate-500 resize-none h-14 focus:outline-none focus:border-slate-700" placeholder="General paragraph comment/notes...">${appState.comments[para.name] || ''}</textarea>
                    </div>
                `;
                card.appendChild(cardFooter);

                // Mount card and activate draggable controller
                container.appendChild(card);
                makeNodeDraggable(card, para.name);
            });

            // Trigger flow connection redraw loop
            setTimeout(drawFlowlines, 20);
        }

        // Toggles tested status of PERFORMs
        function toggleControlCoverage(ctrlId) {
            appState.coverage[ctrlId] = !appState.coverage[ctrlId];
            
            // Re-sync internally inside paragraph list structure recursively
            appState.paragraphs.forEach(p => {
                forEachControl(p.controls, c => {
                    if (c.id === ctrlId) {
                        c.tested = appState.coverage[ctrlId];
                    }
                });
            });

            saveToLocalStorage();
            renderVisualizerWorkspace();
            showNotification("Status Updated", "Testing branch status modified.");
        }

        // Toggles tested status of specific branch options (IF or EVALUATE index targets)
        function toggleBranchCoverage(ctrlId, branchIndex) {
            const key = `${ctrlId}_branch_${branchIndex}`;
            appState.coverage[key] = !appState.coverage[key];

            appState.paragraphs.forEach(p => {
                forEachControl(p.controls, c => {
                    if (c.id === ctrlId) {
                        c.tested[branchIndex] = appState.coverage[key];
                    }
                });
            });

            saveToLocalStorage();
            renderVisualizerWorkspace();
            showNotification("Status Updated", "Sub-branch coverage state updated.");
        }

        // Save inline text comments for controls and branches
        function updateControlNote(ctrlId, text) {
            appState.controlComments[ctrlId] = text;
            saveToLocalStorage();
        }

        function updateBranchNote(ctrlId, branchIndex, text) {
            const key = `${ctrlId}_branch_${branchIndex}`;
            appState.controlComments[key] = text;
            saveToLocalStorage();
        }

        function updateParagraphComment(paraName, text) {
            appState.comments[paraName] = text;
            saveToLocalStorage();
        }

        // Real-time coverage mathematics summary engine
        function updateGlobalStats() {
            let total = 0;
            let tested = 0;

            appState.paragraphs.forEach(p => {
                forEachControl(p.controls, c => {
                    if (c.type === 'IF_ELSE' || c.type === 'EVALUATE') {
                        c.tested.forEach(val => {
                            total++;
                            if (val === true) tested++;
                        });
                    } else {
                        total++;
                        if (c.tested === true) tested++;
                    }
                });
            });

            const percent = total > 0 ? Math.round((tested / total) * 100) : 0;

            document.getElementById('tested-count').innerText = `${tested} / ${total}`;
            document.getElementById('tested-percentage').innerText = `${percent}%`;
            document.getElementById('tested-progress-bar').style.width = `${percent}%`;

            // Report Tab matching variables
            document.getElementById('report-total-paragraphs').innerText = appState.paragraphs.length;
            document.getElementById('report-total-branches').innerText = total;
            document.getElementById('report-tested-branches').innerText = tested;
            document.getElementById('report-percentage').innerText = `${percent}%`;
        }

        // Changes zoom level scale factor for the workspace canvas grid
        function changeZoom(factor) {
            let newZoom = appState.zoomLevel + factor;
            // Cap boundary limits
            if (newZoom < 0.4) newZoom = 0.4;
            if (newZoom > 2.0) newZoom = 2.0;

            appState.zoomLevel = parseFloat(newZoom.toFixed(1));
            applyZoomStyles();
        }

        function resetZoom() {
            appState.zoomLevel = 1.0;
            applyZoomStyles();
        }

        function applyZoomStyles() {
            document.getElementById('zoom-value').innerText = `${Math.round(appState.zoomLevel * 100)}%`;
            document.getElementById('visual-workspace').style.transform = `scale(${appState.zoomLevel})`;
            drawFlowlines();
        }
        
        // Recursive Branch Html Builder for Reports View
        function buildReportLogsRecursive(controls, depth = 0) {
            let html = '';
            controls.forEach(c => {
                let padding = `style="margin-left: ${depth * 12}px"`;
                if (c.type === 'IF_ELSE' || c.type === 'EVALUATE') {
                    html += `<div ${padding} class="text-[10px] font-bold text-slate-400 mt-2 mb-1">${c.text}</div>`;
                    c.tested.forEach((val, idx) => {
                        const key = `${c.id}_branch_${idx}`;
                        const comment = appState.controlComments[key] || '';
                        html += `
                            <div ${padding} class="flex items-start gap-2 ml-2 mt-1">
                                <span class="inline-block w-2.5 h-2.5 rounded-full ${val ? 'bg-emerald-500' : 'bg-rose-500'} mt-0.5 shrink-0"></span>
                                <div class="flex-1">
                                    <span class="font-mono text-[10px] text-slate-200 font-medium">${c.branches[idx].name}</span>
                                    ${comment ? `<div class="text-[9px] text-slate-400 italic">${comment}</div>` : ''}
                                </div>
                            </div>
                        `;
                        // Recurse inner branching rules
                        if (c.branches[idx].controls.length > 0) {
                            html += buildReportLogsRecursive(c.branches[idx].controls, depth + 1.5);
                        }
                    });
                } else {
                    const isTested = appState.coverage[c.id] === true;
                    const comment = appState.controlComments[c.id] || '';
                    html += `
                        <div ${padding} class="flex items-start gap-2 mt-1.5">
                            <span class="inline-block w-2.5 h-2.5 rounded-full ${isTested ? 'bg-emerald-500' : 'bg-rose-500'} mt-0.5 shrink-0"></span>
                            <div class="flex-1">
                                <span class="font-mono text-[10px] text-slate-200 font-medium">${c.text}</span>
                                ${comment ? `<div class="text-[9px] text-slate-400 italic">${comment}</div>` : ''}
                            </div>
                        </div>
                    `;
                }
            });
            return html;
        }

        // Generates clean print-ready markdown summary rows
        function buildCoverageReport() {
            const tbody = document.getElementById('report-tbody');
            if (!tbody) return;

            tbody.innerHTML = '';

            if (appState.paragraphs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="3" class="p-6 text-center text-slate-500 italic">No program paragraphs parsed. Generate flow first.</td></tr>`;
                return;
            }

            appState.paragraphs.forEach(p => {
                // Find and compile paragraph coverage status elements
                let branchLogsHTML = '<div class="space-y-1">';
                
                branchLogsHTML += buildReportLogsRecursive(p.controls);

                if (p.controls.length === 0) {
                    branchLogsHTML = `<span class="text-[10px] text-slate-500 italic">No execution branches</span>`;
                }
                branchLogsHTML += '</div>';

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-850/50 transition-colors";

                tr.innerHTML = `
                    <td class="p-3 align-top border-r border-slate-850">
                        <div class="font-bold text-slate-200 font-mono text-xs">${p.name}</div>
                        <div class="text-[10px] text-cyan-400 font-medium mt-1">${resolveParagraphName(p.name)}</div>
                    </td>
                    <td class="p-3 align-top border-r border-slate-850 w-72">
                        ${branchLogsHTML}
                    </td>
                    <td class="p-3 align-top text-slate-400">
                        ${appState.comments[p.name] ? `<div class="text-[11px] leading-relaxed whitespace-pre-line">${appState.comments[p.name]}</div>` : '<span class="text-slate-600 italic">No notes added.</span>'}
                    </td>
                `;

                tbody.appendChild(tr);
            });
        }

        // Local Browser storage loader
        function loadFromLocalStorage() {
            try {
                const data = localStorage.getItem('cob_viz_workspace_v2');
                if (data) {
                    const parsed = JSON.parse(data);
                    
                    appState.rawCode = parsed.rawCode || "";
                    if (parsed.dictionary) appState.dictionary = parsed.dictionary;
                    appState.resolutions = parsed.resolutions || {};
                    appState.paragraphs = parsed.paragraphs || [];
                    appState.comments = parsed.comments || {};
                    appState.controlComments = parsed.controlComments || {};
                    appState.nodePositions = parsed.nodePositions || {};
                    appState.coverage = parsed.coverage || {};
                    appState.lineControlPoints = parsed.lineControlPoints || {};
                    appState.showResolved = parsed.showResolved === true;
                    appState.stripSequence = parsed.stripSequence !== false;
                    appState.stripComments = parsed.stripComments !== false;
                }
            } catch (err) {
                console.error("Localstorage recovery failed", err);
            }
        }

        // Saves current program visualizer parameters in LocalStorage
        function saveToLocalStorage() {
            try {
                localStorage.setItem('cob_viz_workspace_v2', JSON.stringify({
                    rawCode: appState.rawCode,
                    dictionary: appState.dictionary,
                    resolutions: appState.resolutions,
                    paragraphs: appState.paragraphs,
                    comments: appState.comments,
                    controlComments: appState.controlComments,
                    nodePositions: appState.nodePositions,
                    coverage: appState.coverage,
                    lineControlPoints: appState.lineControlPoints,
                    showResolved: appState.showResolved,
                    stripSequence: appState.stripSequence,
                    stripComments: appState.stripComments
                }));
            } catch (err) {
                console.error("Localstorage backup failed", err);
            }
        }

        // Re-populates textareas/inputs with retrieved data model states
        function updateUIFromState() {
            document.getElementById('cobol-code').value = appState.rawCode;
            document.getElementById('chk-strip-seq').checked = appState.stripSequence;
            document.getElementById('chk-strip-comments').checked = appState.stripComments;

            renderDictionary();
            renderVisualizerWorkspace();
            updateGlobalStats();
        }

        // Direct Manual Save button callback
        function saveProject() {
            saveToLocalStorage();
            showNotification("Saved Status", "Workspace status backed up into browser local storage.");
        }

        // Exports workspace completely into JSON File download
        function exportAsJSON() {
            saveToLocalStorage();
            const payload = JSON.stringify(appState, null, 2);
            const blob = new Blob([payload], { type: "application/json" });
            const url = URL.createObjectURL(blob);
            
            const link = document.createElement('a');
            link.href = url;
            link.download = `cobol-coverage-workspace-${new Date().toISOString().slice(0,10)}.json`;
            link.click();

            URL.revokeObjectURL(url);
            showNotification("Export Complete", "Downloaded current project mapping JSON package.");
        }

        function triggerImport() {
            document.getElementById('file-import').click();
        }

        // Loads a complete workspace dataset file package
        function importFromJsonFile(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const parsed = JSON.parse(e.target.result);
                    
                    if (!parsed.paragraphs) {
                        showNotification("Incorrect File", "Missing valid parser paragraph definitions.", "warn");
                        return;
                    }

                    appState.rawCode = parsed.rawCode || "";
                    if (parsed.dictionary) appState.dictionary = parsed.dictionary;
                    appState.resolutions = parsed.resolutions || {};
                    appState.paragraphs = parsed.paragraphs || [];
                    appState.comments = parsed.comments || {};
                    appState.controlComments = parsed.controlComments || {};
                    appState.nodePositions = parsed.nodePositions || {};
                    appState.coverage = parsed.coverage || {};
                    appState.lineControlPoints = parsed.lineControlPoints || {};
                    appState.showResolved = parsed.showResolved === true;
                    appState.stripSequence = parsed.stripSequence !== false;
                    appState.stripComments = parsed.stripComments !== false;

                    saveToLocalStorage();
                    updateUIFromState();
                    showNotification("Import Succeeded", "Workspace configuration restored!");
                    switchTab('visualizer-tab');
                } catch (err) {
                    showNotification("Import Failure", "Failed to parse selected JSON configuration file.", "warn");
                }
            };
            reader.readAsText(file);
        }

        // Standard sample COBOL script program mock loader
        function loadSampleProgram() {
            const demo = ``;

            document.getElementById('cobol-code').value = demo;
            appState.rawCode = demo;
            
            // Re-generate visualizer automatically
            processSourceCode();
            applyAutoLayout();
        }
    </script>
</body>
</html>
