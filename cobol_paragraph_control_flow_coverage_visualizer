        // Helper to recursively iterate over hierarchical flow control AST 
        function forEachControl(controls, callback) {
            controls.forEach(c => {
                callback(c);
                if (c.type === 'IF_ELSE' || c.type === 'EVALUATE') {
                    c.branches.forEach(b => {
                        forEachControl(b.controls, callback);
                    });
                }
            });
        }

