        // Interactive card dragging controller logic
        function makeNodeDraggable(element, paraName) {
            let offsetXX = 0, offsetYY = 0, mouseXX = 0, mouseYY = 0;

            const header = element.querySelector('.card-drag-handle');
            if (header) {
                header.onmousedown = dragMouseDown;
                header.ontouchstart = dragTouchStart;
            } else {
                element.onmousedown = dragMouseDown;
                element.ontouchstart = dragTouchStart;
            }

            function dragMouseDown(e) {
                // Prevent starting canvas empty space pan when grabbing card
                e.stopPropagation();
                
                // Allow interactions inside input options/menus inside headers
                if (e.target.tagName === 'SELECT' || e.target.tagName === 'OPTION' || e.target.tagName === 'BUTTON' || e.target.closest('button')) {
                    return;
                }
                
                e.preventDefault();
                mouseXX = e.clientX;
                mouseYY = e.clientY;
                document.onmouseup = closeDragElement;
                document.onmousemove = elementDrag;
                element.classList.add('dragging');
            }

            function dragTouchStart(e) {
                e.stopPropagation();
                if (e.touches.length === 1) {
                    mouseXX = e.touches[0].clientX;
                    mouseYY = e.touches[0].clientY;
                    document.ontouchend = closeDragElement;
                    document.ontouchmove = elementTouchDrag;
                    element.classList.add('dragging');
                }
            }

            function elementDrag(e) {
                e.preventDefault();
                offsetXX = mouseXX - e.clientX;
                offsetYY = mouseYY - e.clientY;
                mouseXX = e.clientX;
                mouseYY = e.clientY;

                // Adjust for dynamic workspace scale (zoom)
                const currentX = element.offsetLeft - (offsetXX / appState.zoomLevel);
                const currentY = element.offsetTop - (offsetYY / appState.zoomLevel);

                // Set boundaries to stay in canvas
                const boundedX = Math.max(0, Math.min(3600, currentX));
                const boundedY = Math.max(0, Math.min(2600, currentY));

                element.style.left = boundedX + "px";
                element.style.top = boundedY + "px";

                appState.nodePositions[paraName] = { x: boundedX, y: boundedY };
                drawFlowlines();
            }

            function elementTouchDrag(e) {
                if (e.touches.length === 1) {
                    const clientX = e.touches[0].clientX;
                    const clientY = e.touches[0].clientY;
                    offsetXX = mouseXX - clientX;
                    offsetYY = mouseYY - clientY;
                    mouseXX = clientX;
                    mouseYY = clientY;

                    const currentX = element.offsetLeft - (offsetXX / appState.zoomLevel);
                    const currentY = element.offsetTop - (offsetYY / appState.zoomLevel);

                    const boundedX = Math.max(0, Math.min(3600, currentX));
                    const boundedY = Math.max(0, Math.min(2600, currentY));

                    element.style.left = boundedX + "px";
                    element.style.top = boundedY + "px";

                    appState.nodePositions[paraName] = { x: boundedX, y: boundedY };
                    drawFlowlines();
                }
            }

            function closeDragElement() {
                document.onmouseup = null;
                document.onmousemove = null;
                document.ontouchend = null;
                document.ontouchmove = null;
                element.classList.remove('dragging');
                saveToLocalStorage();
            }
        }

        // Mathematically locates the closest line segment for inserting a new control point
        function getDistanceToSegment(px, py, x1, y1, x2, y2) {
            const dx = x2 - x1;
            const dy = y2 - y1;
            if (dx === 0 && dy === 0) {
                return Math.hypot(px - x1, py - y1);
            }
            const t = ((px - x1) * dx + (py - y1) * dy) / (dx * dx + dy * dy);
            const clampedT = Math.max(0, Math.min(1, t));
            const projX = x1 + clampedT * dx;
            const projY = y1 + clampedT * dy;
            return Math.hypot(px - projX, py - projY);
        }

        // Draws precise flow lines from source performs to target paragraphs
        function drawFlowlines() {
            const svgGroup = document.getElementById('svg-connections-group');
            if (!svgGroup) return;

            svgGroup.innerHTML = '';

            const workspace = document.getElementById('visual-workspace');
            const workspaceRect = workspace.getBoundingClientRect();

            appState.paragraphs.forEach(para => {
                forEachControl(para.controls, ctrl => {
                    // Check if control link targets another valid paragraph
                    if (ctrl.target) {
                        const targetPara = appState.paragraphs.find(p => p.name === ctrl.target);
                        if (targetPara) {
                            const sourceRow = document.getElementById(`row-${ctrl.id}`);
                            const targetCard = document.getElementById(`card-${targetPara.name}`);

                            if (sourceRow && targetCard) {
                                const srcRect = sourceRow.getBoundingClientRect();
                                const destRect = targetCard.getBoundingClientRect();

                                // Calculate positions normalized against workspace container and zoom level
                                const x1 = (srcRect.right - workspaceRect.left) / appState.zoomLevel;
                                const y1 = ((srcRect.top + srcRect.bottom) / 2 - workspaceRect.top) / appState.zoomLevel;
                                const x2 = (destRect.left - workspaceRect.left) / appState.zoomLevel;
                                const y2 = ((destRect.top + destRect.bottom) / 2 - workspaceRect.top) / appState.zoomLevel;

                                const connectionKey = `${ctrl.id}_to_${targetPara.name}`;
                                const pts = appState.lineControlPoints[connectionKey] || [];

                                let pathD = "";
                                if (pts.length === 0) {
                                    let offset = Math.abs(x2 - x1) * 0.5;
                                    if (offset < 60) offset = 60;

                                    // Path drawing strategy: S-curves for forward paths, multi-curves loops for backward/same loops
                                    if (x2 >= x1) {
                                        pathD = `M ${x1} ${y1} C ${x1 + offset} ${y1}, ${x2 - offset} ${y2}, ${x2} ${y2}`;
                                    } else {
                                        // Loop backwards gracefully to avoid line spaghetti overlapping
                                        const cp1x = x1 + 100;
                                        const cp1y = y1;
                                        const cp2x = x2 - 100;
                                        const cp2y = y2;
                                        pathD = `M ${x1} ${y1} C ${cp1x} ${cp1y}, ${cp1x} ${y1 + (y2 - y1)/2}, ${cp2x} ${y1 + (y2 - y1)/2} C ${cp2x} ${y1 + (y2 - y1)/2}, ${cp2x} ${cp2y}, ${x2} ${y2}`;
                                    }
                                } else {
                                    // Use clean rounded-joint segmented lines for manual routes
                                    pathD = `M ${x1} ${y1}`;
                                    pts.forEach(pt => {
                                        pathD += ` L ${pt.x} ${pt.y}`;
                                    });
                                    pathD += ` L ${x2} ${y2}`;
                                }

                                const isTested = appState.coverage[ctrl.id] === true;
                                const color = isTested ? '#10b981' : '#ef4444';
                                const marker = isTested ? 'url(#arrow-tested)' : 'url(#arrow-untested)';

                                // Dual SVG Paths: Invisible thick path for mouse clicks, and thin colored one
                                const g = document.createElementNS("http://www.w3.org/2000/svg", "g");

                                // Thick clickable helper line
                                const pathHelper = document.createElementNS("http://www.w3.org/2000/svg", "path");
                                pathHelper.setAttribute("d", pathD);
                                pathHelper.setAttribute("stroke", "transparent");
                                pathHelper.setAttribute("stroke-width", "12");
                                pathHelper.setAttribute("fill", "none");
                                pathHelper.setAttribute("pointer-events", "stroke");
                                pathHelper.setAttribute("class", "cursor-pointer");

                                // Visible path
                                const pathReal = document.createElementNS("http://www.w3.org/2000/svg", "path");
                                pathReal.setAttribute("d", pathD);
                                pathReal.setAttribute("stroke", color);
                                pathReal.setAttribute("stroke-width", "2.5");
                                pathReal.setAttribute("fill", "none");
                                pathReal.setAttribute("marker-end", marker);
                                pathReal.setAttribute("class", "flow-path");
                                pathReal.setAttribute("stroke-linejoin", "round");
                                pathReal.setAttribute("stroke-linecap", "round");
                                pathReal.style.color = color;

                                // Dragging on the line spawns a control point; Simple click toggles status
                                pathHelper.addEventListener('mousedown', function(e) {
                                    if (e.button !== 0) return;
                                    e.stopPropagation();

                                    const rect = workspace.getBoundingClientRect();
                                    const mouseX = (e.clientX - rect.left) / appState.zoomLevel;
                                    const mouseY = (e.clientY - rect.top) / appState.zoomLevel;

                                    if (!appState.lineControlPoints[connectionKey]) {
                                        appState.lineControlPoints[connectionKey] = [];
                                    }

                                    const activePts = appState.lineControlPoints[connectionKey];
                                    const fullPoints = [{x: x1, y: y1}, ...activePts, {x: x2, y: y2}];

                                    let minDist = Infinity;
                                    let insertIdx = 0;
                                    for (let i = 0; i < fullPoints.length - 1; i++) {
                                        const dist = getDistanceToSegment(mouseX, mouseY, fullPoints[i].x, fullPoints[i].y, fullPoints[i+1].x, fullPoints[i+1].y);
                                        if (dist < minDist) {
                                            minDist = dist;
                                            insertIdx = i; // Map perfectly to the array insertion index
                                        }
                                    }

                                    appState.lineControlPoints[connectionKey].splice(insertIdx, 0, {x: mouseX, y: mouseY});

                                    isDraggingCP = true;
                                    activeCPDrag = {
                                        connectionKey: connectionKey,
                                        index: insertIdx
                                    };

                                    saveToLocalStorage();
                                    drawFlowlines();
                                });

                                pathHelper.addEventListener('click', function() {
                                    if (isDraggingCP) return;
                                    toggleControlCoverage(ctrl.id);
                                });

                                g.appendChild(pathHelper);
                                g.appendChild(pathReal);
                                svgGroup.appendChild(g);

                                // Render manual line control point visual handles
                                pts.forEach((pt, idx) => {
                                    const circle = document.createElementNS("http://www.w3.org/2000/svg", "circle");
                                    circle.setAttribute("cx", pt.x);
                                    circle.setAttribute("cy", pt.y);
                                    circle.setAttribute("r", "7");
                                    circle.setAttribute("fill", "#22d3ee"); // Vivid cyan handle dot
                                    circle.setAttribute("stroke", "#ffffff");
                                    circle.setAttribute("stroke-width", "2");
                                    circle.setAttribute("class", "cursor-move hover:scale-125 transition-transform duration-100");
                                    circle.style.pointerEvents = "all";

                                    circle.addEventListener('mousedown', function(e) {
                                        if (e.button !== 0) return;
                                        e.stopPropagation();
                                        e.preventDefault();
                                        isDraggingCP = true;
                                        activeCPDrag = {
                                            connectionKey: connectionKey,
                                            index: idx
                                        };
                                    });

                                    circle.addEventListener('contextmenu', function(e) {
                                        e.preventDefault();
                                        e.stopPropagation();
                                        appState.lineControlPoints[connectionKey].splice(idx, 1);
                                        saveToLocalStorage();
                                        drawFlowlines();
                                        showNotification("Removed Control Point", "Re-aligned connection line route.");
                                    });

                                    const title = document.createElementNS("http://www.w3.org/2000/svg", "title");
                                    title.textContent = "Drag to route path. Right-click to remove point.";
                                    circle.appendChild(title);
                                    svgGroup.appendChild(circle);
                                });
                            }
                        }
                    }
                });
            });

            updateGlobalStats();
        }

        // Helper recursive renderer for paragraph execution block rows
        function renderControlsToCard(controls, container, isNested = false) {
